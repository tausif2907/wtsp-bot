PORT=3000
MONGODB_URI=mongodb://localhost:27017/tailorbot
WHATSAPP_TOKEN=your_meta_token
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
OWNER_PHONE_NUMBER=owner_number_with_country_code

# Online store database (same Supabase project as the website's .env.local).
# Use ONLY the publishable/anon key here, never the service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Website address, used for product links (e.g. https://rashmiboutique.in)
WEBSITE_URL=

# Optional contact lines shown to customers (blank lines are hidden)
STORE_EMAIL=
STORE_INSTAGRAM=
