PORT=3000
# The bot's own data (bookings, customers, chats, logins) lives in the store's Supabase project.
# Run supabase/bot-database.sql there first. Then copy Supabase -> Connect -> "Session pooler",
# change the user to rashmi_bot.<project-ref> and use the password you put in that SQL file.
DATABASE_URL=postgresql://rashmi_bot.your-project-ref:your-bot-password@aws-0-your-region.pooler.supabase.com:5432/postgres
WHATSAPP_TOKEN=your_meta_token
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
OWNER_PHONE_NUMBER=owner_number_with_country_code

# Signs dashboard logins. Use a long random value, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Online store database (same Supabase project as the website's .env.local).
# Use ONLY the publishable/anon key here, never the service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Website address, used for product links (e.g. https://rashmiboutique.in)
WEBSITE_URL=

# Optional contact lines shown to customers (blank lines are hidden)
STORE_EMAIL=
STORE_INSTAGRAM=
